# EmailJS – copy to .env and fill in from https://dashboard.emailjs.com
# Service: create one under Email Services. Templates: create two under Email Templates.

VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
VITE_EMAILJS_ADMIN_TEMPLATE_ID=your_admin_template_id
VITE_EMAILJS_USER_TEMPLATE_ID=your_user_template_id

# Admin template (for Beereshjiawasthi@gmail.com):
#   To Email: Beereshjiawasthi@gmail.com (or {{to_email}})
#   Subject: {{subject}}
#   Content (HTML): {{html_content}}
#
# User template (to customer):
#   To Email: {{user_email}}
#   Subject: {{subject}}
#   Content (HTML): {{html_content}}
